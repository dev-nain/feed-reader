{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "frontpage-feed-reader-main",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-07-24",
	"compatibility_flags": ["nodejs_compat"],

	"observability": {
		"enabled": true
	},

	"vars": {
		"APP_ENV": "development"
	},

	// The Cloudflare Vite plugin resolves the environment at BUILD time, so these
	// blocks are selected with `CLOUDFLARE_ENV=<env> npm run build`. The `--env`
	// flag on `wrangler deploy` only re-checks that choice — it cannot make it.
	"env": {
		"staging": {
			"name": "frontpage-feed-reader-main-staging",
			"workers_dev": true,
			"vars": {
				"APP_ENV": "staging"
			}
		},

		"production": {
			"name": "frontpage-feed-reader-main",
			"workers_dev": true,
			"vars": {
				"APP_ENV": "production"
			}
		}
	}
}
