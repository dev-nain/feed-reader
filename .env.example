# Copy to `.env` and fill in. `.env` is git-ignored and never committed.
#
# In development the Cloudflare Vite plugin loads these into the Worker's `env`
# object, which is the only way route code reads configuration — see
# `app/context.ts`. In production they are Worker vars and secrets instead:
#
#   npx wrangler secret put SUPABASE_SECRET_KEY --env production
#
# Values come from the Supabase dashboard (Project Settings → API keys), or from
# `supabase start` for the local stack.

# Public — safe in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Secret — server only. Never referenced from a component or a `.tsx` route
# module. Unused until step 3 (feed ingestion) needs the service role.
SUPABASE_SECRET_KEY=

# GitHub OAuth, for the LOCAL Supabase stack only (supabase/config.toml reads
# these). Create an OAuth app at https://github.com/settings/developers with the
# callback URL http://127.0.0.1:54321/auth/v1/callback.
# The hosted project sets this in Dashboard -> Authentication -> Providers, and
# uses the callback URL https://<project-ref>.supabase.co/auth/v1/callback.
GITHUB_CLIENT_ID=
GITHUB_SECRET=
